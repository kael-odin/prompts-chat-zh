# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# GitHub Actions 里则配置为仓库 Secrets，变量名保持一致。

# 翻译用的 OpenAI 兼容端点（结尾不含 /chat/completions）
TRANSLATE_BASE_URL=https://xc.lifesecretary.com:8000/v1

# 中转站的 key
TRANSLATE_API_KEY=

# 模型：deepseek-chat 是唯一非推理模型，批量翻译必须用它
# （deepseek-flash / deepseek-v4-* 每句都会烧掉上百个推理 token）
TRANSLATE_MODEL=deepseek-chat

# 上游数据源，一般不用改
UPSTREAM_API=https://prompts.chat/api/prompts
