# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# GitHub Actions 里则配置为仓库 Secrets，模型名放在仓库 Variables（TRANSLATE_MODEL）。

# 翻译用的 OpenAI 兼容端点（结尾不含 /chat/completions）
TRANSLATE_BASE_URL=https://xc.lifesecretary.com:8000/v1

# 中转站的 key（注意：key 分组要包含所选模型，否则报 model_not_found）
TRANSLATE_API_KEY=

# 模型 id。推理模型可以用：脚本会自动剥离内联的 <think> 思考标签，
# 并给输出留足了 token 预算。优先选 flash 档，批量翻译调用量大，pro 档没必要。
TRANSLATE_MODEL=glm-5.3-flash

# 上游数据源，一般不用改
UPSTREAM_API=https://prompts.chat/api/prompts
