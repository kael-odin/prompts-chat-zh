---
import PromptCard from './PromptCard.astro';
import { url } from '../lib/url.js';

const { prompts, page = 1, totalPages = 1, basePath = '/prompts' } = Astro.props;

const pageUrl = (n) => (n === 1 ? `${basePath}/` : `${basePath}/page/${n}/`);

/** 窗口式页码：首页、末页恒定显示，当前页前后各 2 页，其余折叠成省略号。 */
function pageItems(current, total) {
  const items = [];
  const want = new Set([1, total, current, current - 1, current + 1, current - 2, current + 2]);
  let last = 0;
  for (const n of [...want].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b)) {
    if (last && n - last > 1) items.push('gap');
    items.push(n);
    last = n;
  }
  return items;
}

const items = pageItems(page, totalPages);
---

<ul class="grid">
  {prompts.map((p) => <PromptCard prompt={p} />)}
</ul>

{
  totalPages > 1 && (
    <nav class="pager" aria-label="分页">
      {page > 1 ? <a href={url(pageUrl(page - 1))} rel="prev">上一页</a> : null}

      {items.map((it) =>
        it === 'gap' ? (
          <span class="gap" aria-hidden="true">…</span>
        ) : it === page ? (
          <span class="current" aria-current="page">{it}</span>
        ) : (
          <a href={url(pageUrl(it))}>{it}</a>
        ),
      )}

      {page < totalPages ? <a href={url(pageUrl(page + 1))} rel="next">下一页</a> : null}
    </nav>
  )
}
