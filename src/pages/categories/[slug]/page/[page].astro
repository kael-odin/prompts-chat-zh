---
import Base from '../../../../layouts/Base.astro';
import PromptGrid from '../../../../components/PromptGrid.astro';
import { getSite } from '../../../../lib/site.js';
import { sortPrompts, restPages } from '../../../../lib/paginate.js';
import { PER_PAGE } from '../../../../lib/config.js';
import { url } from '../../../../lib/url.js';

const site = getSite();

// getStaticPaths 被 Astro 提升到模块顶部，只能引用 import，故内部重新取一次
export async function getStaticPaths() {
  const s = getSite();
  const out = [];
  for (const c of s.categories) {
    const list = sortPrompts(s.prompts.filter((p) => p.category?.slug === c.slug));
    for (const p of restPages(list, PER_PAGE, (prompts) => ({ prompts }))) {
      out.push({
        params: { slug: c.slug, page: p.params.page },
        props: { ...p.props, name: c.name, count: c.count },
      });
    }
  }
  return out;
}

const { prompts, page, totalPages, name, count } = Astro.props;
const basePath = `/categories/${Astro.params.slug}`;
---

<Base title={`${name} 类提示词 · 第 ${page} 页`} description={`${name} 分类下的提示词第 ${page} 页。`}>
  <div class="crumbs">
    <a href={url('/')}>首页</a> <span aria-hidden="true">/</span>
    <a href={url('/categories/')}>分类</a> <span aria-hidden="true">/</span>
    <a href={url(`${basePath}/`)}>{name}</a> <span aria-hidden="true">/</span> 第 {page} 页
  </div>

  <div class="section-head">
    <h2>{name}</h2>
    <span class="more" style="color:var(--ink-3)">
      共 {count} 条 · 第 {page} / {totalPages} 页
    </span>
  </div>

  <PromptGrid prompts={prompts} page={page} totalPages={totalPages} basePath={basePath} />
</Base>
